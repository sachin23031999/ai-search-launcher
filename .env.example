# AI Search Launcher — LLM configuration
# Copy this file to `.env` (same folder) and fill in your key.
# `.env` is git-ignored; scripts\run-app.ps1 loads it automatically.
# Existing shell environment variables take precedence over values here.

# Provider: openai | anthropic | google
LLM_PROVIDER=openai

# Your API key (OpenAI keys start with "sk-").
LLM_API_KEY=sk-your-key-here

# Optional. Defaults per provider:
#   openai    -> gpt-4o
#   anthropic -> claude sonnet 4.5  (or "haiku" for Haiku 4.5)
#   google    -> gemini 2.5 flash   (or "pro" for 2.5 Pro)
LLM_MODEL=gpt-4o
